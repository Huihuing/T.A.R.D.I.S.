{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
        "Reporting-Endpoints": "csp-endpoint=\"/api/security/csp-report\"",
        "Content-Security-Policy-Report-Only": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://t-a-r-d-i-s.onrender.com wss://t-a-r-d-i-s.onrender.com https://accounts.google.com; frame-src https://accounts.google.com https://s.tradingview.com; report-uri /api/security/csp-report; report-to csp-endpoint"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "https://t-a-r-d-i-s.onrender.com/api/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "X-Tardis-Proxy-Secret"
          },
          "args": "$TRUSTED_PROXY_SECRET",
          "env": [
            "TRUSTED_PROXY_SECRET"
          ]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
